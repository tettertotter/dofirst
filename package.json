{
  "name": "todaypool",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.0.0",
  "devDependencies": {
    "@types/react": "^18.3.1",
    "turbo": "^1.13.3"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "supabase/functions/*",
    "tooling/*"
  ],
  "scripts": {
    "dev:web": "pnpm --filter @todaypool/web dev",
    "dev:mobile": "pnpm --filter @todaypool/mobile start",
    "build": "turbo build"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "18.3.27",
      "@types/react-dom": "18.3.7"
    }
  }
}